# Runtime
PORT=3000
HOST=0.0.0.0
NODE_ENV=development
CORS_ORIGINS=http://localhost:3000
NEXUS_REQUEST_TIMEOUT_MS=18000
NEXUS_PROVIDER_ORDER=gemini,groq,openrouter,deepseek

# AI providers (configure pelo menos um; nunca commite valores reais)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-chat
OPENROUTER_SITE_URL=http://localhost:3000
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# Untitled: URL WebSocket do runtime/renderizador Untitled
UNTITLED_WS_URL=
UNTITLED_WS_PROTOCOL=
UNTITLED_WS_TOKEN=

# Opcional para o helper ngrok/start-tunnel.sh
NGROK_AUTHTOKEN=
NGROK_DOMAIN=
